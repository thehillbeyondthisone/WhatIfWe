{
  "name": "what-if-we",
  "version": "1.1.0",
  "description": "A couples' date idea planning app - What if we…",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "remote": "node server.js --ngrok",
    "remote:eu": "node server.js --ngrok --region=eu",
    "remote:ap": "node server.js --ngrok --region=ap",
    "remote:au": "node server.js --ngrok --region=au",
    "remote:sa": "node server.js --ngrok --region=sa",
    "remote:jp": "node server.js --ngrok --region=jp",
    "remote:in": "node server.js --ngrok --region=in"
  },
  "keywords": [
    "date",
    "ideas",
    "couples",
    "planning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "ngrok": "^5.0.0-beta.2"
  }
}
